{
  "version": "v1.0",
  "cut_settings": {
    "max_segment_duration": 3.0,
    "transition_style": "hard_cut",
    "zoom_on_impact": true,
    "zoom_intensity": 1.2
  },
  "text_overlay": {
    "duration_seconds": 2.5,
    "highlight_keywords": ["secret", "truth", "never", "dark"],
    "font_size": 72,
    "font_color": "#FFFFFF",
    "stroke_color": "#000000",
    "stroke_width": 3
  },
  "danger_zones": [5, 15, 25, 35],
  "danger_zone_effects": {
    "5": "zoom_in",
    "15": "text_flash",
    "25": "sound_effect",
    "35": "color_shift"
  }
}
